rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // -----------------------------------------------------------------------
    // User avatars — any signed-in user can view; only owner can write
    // -----------------------------------------------------------------------
    match /users/{uid}/avatar.{ext} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------------
    // Pre-approval letters — strictly private (owner only)
    // -----------------------------------------------------------------------
    match /users/{uid}/preApproval.{ext} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------------
    // Listing photos — any signed-in user can read;
    // only the listing's seller can write
    // -----------------------------------------------------------------------
    match /listings/{listingId}/photos/{photoId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid ==
                      firestore.get(/databases/(default)/documents/listings/$(listingId))
                        .data.sellerId;
    }

    // -----------------------------------------------------------------------
    // Listing documents (disclosures, etc.) —
    // any signed-in user can read (MVP default);
    // only seller can write
    // -----------------------------------------------------------------------
    match /listings/{listingId}/documents/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid ==
                      firestore.get(/databases/(default)/documents/listings/$(listingId))
                        .data.sellerId;
    }

  }
}
