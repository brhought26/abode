rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // users/{uid}
    // Any signed-in user can read another user's public profile.
    // Only the owner can write their own document.
    // -----------------------------------------------------------------------
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == uid;

      // favorites subcollection — owner only
      match /favorites/{listingId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // -----------------------------------------------------------------------
    // listings/{listingId}
    // Public reads for active listings; seller reads their own drafts.
    // Create requires email verification.
    // Update / delete restricted to the seller.
    // -----------------------------------------------------------------------
    match /listings/{listingId} {
      allow read: if resource.data.status == "active"
                  || (request.auth != null
                      && request.auth.uid == resource.data.sellerId);

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.sellerId
                    && request.auth.token.email_verified == true;

      allow update, delete: if request.auth != null
                             && request.auth.uid == resource.data.sellerId;
    }

    // -----------------------------------------------------------------------
    // conversations/{cid}
    // Only the two participants can read or write the conversation document.
    // -----------------------------------------------------------------------
    match /conversations/{cid} {
      allow read, write: if request.auth != null
                         && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      // messages subcollection — same participant check via parent doc lookup
      match /messages/{mid} {
        allow read, write: if request.auth != null
                           && request.auth.uid in
                              get(/databases/$(database)/documents/conversations/$(cid))
                                .data.participants;
      }
    }

    // -----------------------------------------------------------------------
    // offers/{oid}
    // Buyer or seller can read their own offer.
    // Buyer creates (email-verified). Buyer or seller can update (status transitions).
    // -----------------------------------------------------------------------
    match /offers/{oid} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.buyerId
                      || request.auth.uid == resource.data.sellerId);

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.buyerId
                    && request.auth.token.email_verified == true;

      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.buyerId
                        || request.auth.uid == resource.data.sellerId);
    }

    // -----------------------------------------------------------------------
    // showings/{sid}
    // Buyer or seller can read. Buyer creates. Either party can update
    // (buyer cancels; seller confirms/declines).
    // -----------------------------------------------------------------------
    match /showings/{sid} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.buyerId
                      || request.auth.uid == resource.data.sellerId);

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.buyerId;

      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.sellerId
                        || request.auth.uid == resource.data.buyerId);
    }

  }
}
